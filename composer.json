{
    "name": "buckaroo/prestashop",
    "version": "5.3.1",
    "description": "Buckaroo Payments",
    "authors": [
        {
            "name": "Buckaroo B.V.",
            "email": "plugins@buckaroo.nl"
        }
    ],
    "require": {
        "php": ">=7.4",
        "buckaroo/sdk": "1.24.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "phpstan/phpstan": "^1.12",
        "prestashop/php-dev-tools": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Buckaroo\\PrestaShop\\Src\\": "src",
            "Buckaroo\\PrestaShop\\Classes\\": "classes",
            "Buckaroo\\PrestaShop\\Controllers\\": "controllers",
            "Buckaroo\\PrestaShop\\Library\\": "library"
        }
      },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml --no-coverage",
        "phpstan": "phpstan analyse --configuration=tests/phpstan/phpstan.neon --no-progress",
        "validate-source": "@php .github/scripts/validate-package.php source",
        "build-release": "bash .github/scripts/build-release.sh --worktree"
    },
    "scripts-descriptions": {
        "test": "Run the PHPUnit suite.",
        "phpstan": "Run PHPStan (requires _PS_ROOT_DIR_ pointing to a PrestaShop installation).",
        "validate-source": "Run the local validator checks against the working tree.",
        "build-release": "Build and validate a release ZIP from the working tree."
    },
    "config": {
        "platform": {
            "php": "7.4"
        },
        "preferred-install": "dist",
        "prepend-autoloader": false,
        "sort-packages": true
    },
    "type": "prestashop-module",
    "author": "Buckaroo B.V.",
    "license": "AFL"
}
